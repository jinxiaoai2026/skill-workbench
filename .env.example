# Copy to .env on your server. Do not commit actual credentials.
DOMAIN=skills.example.com
APP_ORIGIN=https://skills.example.com
# URL-safe random value; avoid reserved URL characters in the DB password.
POSTGRES_PASSWORD=
ADMIN_PASSWORD=
# Generate 32 random bytes encoded as 64 hexadecimal characters.
SESSION_KEY=
# Optional: improves repository metadata rate limits. Public read access only.
GITHUB_TOKEN=
# 云端中文模型在管理员网页“设置与连接 → 云端中文介绍”中配置。
# 默认关闭；API Key 加密保存在私有数据库，不添加到源码或前端环境变量。
# 生产 SESSION_KEY 需持久保存，轮换后需要重新填写模型 API Key。
